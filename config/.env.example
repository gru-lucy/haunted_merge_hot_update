# Copy to .env.development / .env.production.

# BackendConfig.ReleaseUpdatePort in the game.
PORT=5300

# Holds android/<versionCode>/{manifest.json, manifest.sig, files/}. Copy the editor's
# Builds/HotUpdate/android/<code>/ here: files/ first, the manifest last.
UPDATE_ROOT=./www

# The lobby's TLS files: same certificate, so the game's key pin (ServerTrust.cs) holds.
# Leave all three empty for plain HTTP on a dev PC - release builds will not use it.
TLS_CERT_FILE=D:/Haunted_Merge/Keystore/tls/server.crt
TLS_KEY_FILE=D:/Haunted_Merge/Keystore/tls/server.key
# The CA behind the app's client certificate (the lobby's TLS_CLIENT_CA_FILE).
TLS_CLIENT_CA_FILE=D:/Haunted_Merge/Keystore/tls/client-ca.pem
